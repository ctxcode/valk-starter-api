use sql
use uuid
use valk.crypto
use valk.time

/// A person who can log in.
+ class User {
    /// The id, a version 7 uuid: time ordered, so rows land next to each other in the index.
    + id: uuid.Uuid
    /// What they log in with.
    + email: String
    /// The Argon2id hash stored in the database; omitted from JSON responses.
    password_hash: String ("") $tag(json: "-")
    /// When the account was made.
    + created_at: String
}

/// Thrown by the things a user can do.
+ union UserError {
    taken(String)
    unknown(String)
    password(String)
    database(String)

    + get message: String {
        return match this : String {
            .taken(msg) => msg
            .unknown(msg) => msg
            .password(msg) => msg
            .database(msg) => msg
        }
    }

    + fn to_string() String $auto {
        return this.message
    }
}

/// Creates a user, and returns it.
///
/// The password is hashed with Argon2id; what goes in the database can never be read back.
+ fn create_user(db: sql.Db, email: String, password: String) User !UserError {
    if email.length == 0 || !email.contains("@") : throw .unknown("'" + email + "' is not an email address")
    if password.length < 8 : throw .password("A password needs at least eight characters")

    let hash = crypto.argon2id_hash(password) ! throw .password("Cannot hash the password")
    let user = User {
        id: uuid.v7()
        email: email.lower()
        password_hash: hash
        created_at: time.DateTime.now().to_iso8601()
    }

    db.insert_into("users").values(sql.values_of(user)).run() ! {
        if E is .constraint : throw .taken("That email is already taken")
        throw .database(E.message)
    }
    return user
}

/// Returns the user with this email and password, or throws.
+ fn sign_in(db: sql.Db, email: String, password: String) User !UserError {
    let row = db.select().from("users").where("email", email.lower()).one() ! {
        throw .database(E.message)
    }
    if !isset(row) : throw .unknown("No account has that email")

    let user = sql.row_to[User](row) ! throw .database(E.message)
    if !crypto.argon2id_verify(password, user.password_hash) : throw .password("That password does not match")
    return user
}

/// Returns the user with this id, or null.
+ fn find_user(db: sql.Db, id: String) ?User !UserError {
    let row = db.select().from("users").where("id", id).one() ! {
        throw .database(E.message)
    }
    if !isset(row) : return null
    return sql.row_to[User](row) ! throw .database(E.message)
}

/// Returns the users, newest first.
+ fn list_users(db: sql.Db, limit: uint (50)) Array[User] !UserError {
    let rows = db.select().from("users").order_by("created_at DESC").limit(limit).all() ! {
        throw .database(E.message)
    }
    return sql.rows_to[User](rows) ! throw .database(E.message)
}

/// Returns how many users there are.
+ fn count_users(db: sql.Db) uint !UserError {
    return db.select().from("users").count() ! {
        throw .database(E.message)
    }
}
