use sql
use sqlite

/// Opens the database and makes sure it has the tables this program needs.
///
/// The migrations are embedded, so the program carries its own schema and needs no files where
/// it runs.
+ fn open_database(path: String) sql.Db !sql.Error {
    let con = sqlite.open(path) ! throw .connect { message: "Cannot open " + path + ": " + E.message }
    let db = sqlite.database(con)
    migrate(db) !>
    return db
}

/// Runs the migrations that have not run yet, and returns their names.
+ fn migrate(db: sql.Db) Array[String] !sql.Error {
    let migrator = sql.Migrator.new(db)
    migrator.add_many(#embed_dir("migrations"))
    return migrator.migrate() !>
}
